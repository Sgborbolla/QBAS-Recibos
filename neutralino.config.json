{
  "applicationId": "com.qbaswing.qbasrecibos",
  "version": "1.0.0",
  "applicationName": "QBAS - Generador de Recibos",
  "author": "QBASWING DESIGNER - Dr. Sergio Grabiel Borbolla Verdecia",
  "description": "Generador de recibos profesionales (ES/EN, 100% sin conexion)",
  "copyright": "Copyright (c) 2026 QBASWING DESIGNER. Todos los derechos reservados.",
  "applicationIcon": "src/img/qbas-icon.png",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/src/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "filesystem.*",
    "os.*"
  ],
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "QBAS - Generador de Recibos",
      "width": 1100,
      "height": 780,
      "minWidth": 820,
      "minHeight": 600,
      "resizable": true,
      "center": true,
      "icon": "/src/img/qbas-icon.png",
      "enableInspector": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "QBASRecibos",
    "resourcesPath": "/src/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/src/js/neutralino.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0"
  }
}
